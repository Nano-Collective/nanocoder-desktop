{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"isolatedModules": true,
		"noEmit": true,
		"types": [],
		"paths": {
			"@/*": ["./source/*"]
		}
	},
	"include": ["source/renderer/**/*", "source/shared/**/*"],
	"exclude": ["source/**/*.spec.ts"]
}
