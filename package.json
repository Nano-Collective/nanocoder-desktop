{
	"name": "@nanocollective/nanocoder-desktop",
	"version": "0.0.0",
	"private": true,
	"description": "A local-first desktop workspace around Nanocoder: durable project chats, file browsing, Git review, a terminal and an isolated browser the agent can use.",
	"keywords": [
		"nanocoder",
		"desktop",
		"agent",
		"acp",
		"local-first"
	],
	"author": "Nano Collective",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/Nano-Collective/nanocoder-desktop.git"
	},
	"homepage": "https://github.com/Nano-Collective/nanocoder-desktop#readme",
	"bugs": {
		"url": "https://github.com/Nano-Collective/nanocoder-desktop/issues"
	},
	"type": "module",
	"main": "out/main/index.js",
	"desktopName": "nanocoder-desktop.desktop",
	"packageManager": "pnpm@11.0.9",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "electron-vite dev",
		"build": "electron-vite build",
		"start": "electron-vite preview",
		"package": "pnpm build && electron-builder",
		"package:dir": "pnpm build && electron-builder --dir",
		"format": "biome check --write .",
		"test:all": "pnpm test:format && pnpm test:types && pnpm test:lint && pnpm test:ava && pnpm test:knip && pnpm test:audit",
		"test:format": "biome ci --formatter-enabled=true --linter-enabled=false --assist-enabled=false .",
		"test:types": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.e2e.json",
		"test:lint": "biome lint .",
		"test:lint:fix": "biome lint --write .",
		"test:ava": "ava",
		"test:ava:coverage": "c8 --reporter=text --reporter=json-summary ava",
		"test:e2e": "pnpm build && playwright test",
		"test:acp": "ava --config ava.acp.config.js",
		"test:knip": "knip",
		"test:audit": "pnpm audit --audit-level=high",
		"test:security": "semgrep scan --config auto --error",
		"changeset": "changeset",
		"changeset:version": "changeset version && node scripts/normalize-changelog.js",
		"prepare": "husky",
		"postinstall": "electron-builder install-app-deps",
		"fetch:node": "node scripts/fetch-node-sidecar.mjs",
		"measure:runtime": "node scripts/measure-runtime.mjs"
	},
	"lint-staged": {
		"*.{js,ts,jsx,tsx,json,md}": [
			"biome check --write --no-errors-on-unmatched"
		]
	},
	"ava": {
		"extensions": [
			"ts",
			"mjs"
		],
		"nodeArguments": [
			"--import=tsx",
			"--no-warnings"
		],
		"files": [
			"source/**/*.spec.ts",
			"scripts/**/*.spec.mjs"
		],
		"workerThreads": false,
		"serial": true,
		"environmentVariables": {
			"NODE_ENV": "test"
		}
	},
	"c8": {
		"include": [
			"source/**/*.ts"
		],
		"exclude": [
			"source/**/*.spec.ts",
			"source/**/fixtures/**",
			"source/main/index.ts",
			"source/preload/**",
			"source/renderer/**"
		],
		"reporter": [
			"text",
			"json-summary",
			"lcov"
		],
		"lines": 80,
		"functions": 0,
		"branches": 0,
		"statements": 0
	},
	"devDependencies": {
		"@agentclientprotocol/sdk": "^1.9.0",
		"@biomejs/biome": "^2.5.15",
		"@changesets/cli": "^3.0.3",
		"@playwright/test": "^1.64.1",
		"@types/node": "^24.19.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"ava": "^8.1.0",
		"c8": "^12.0.0",
		"electron": "45.1.0",
		"electron-builder": "^26.18.0",
		"electron-vite": "^6.0.0",
		"husky": "^9.1.7",
		"knip": "^6.42.0",
		"lint-staged": "^17.6.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vite": "^8.3.4",
		"zod": "^4.6.7"
	}
}
