{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"entry": [
		"source/main/index.ts",
		"source/main/terminal/pty-worker.ts",
		"source/preload/index.ts",
		"source/renderer/main.tsx",
		"e2e/**/*.e2e.ts",
		"scripts/*.{js,mjs}",
		"ava.acp.config.js",
		"source/**/*.acp.ts"
	],
	"project": ["source/**/*.{ts,tsx}", "e2e/**/*.ts"],
	"ignoreBinaries": ["semgrep"],
	"ignoreExportsUsedInFile": {
		"interface": true,
		"type": true
	}
}
